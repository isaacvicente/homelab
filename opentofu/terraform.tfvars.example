# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored and must never be committed.

# --- Incus ---
incus_remote     = "homelab"
storage_pool     = "default"
bridge_interface = "br0"

# --- Talos ---
talos_version = "v1.13.8"

# Talos Image Factory schematic ID
# 1. Visit: https://factory.talos.dev
# 2. Under "System Extensions", add: siderolabs/qemu-guest-agent
# 3. Click "Generate" — copy the schematic ID shown
talos_schematic_id = "ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515"

# --- Cluster ---
cluster_name = "homelab"
cluster_vip  = "192.168.18.200" # Must be outside your router's DHCP pool
