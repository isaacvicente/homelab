# To create:
# 1. Visit: https://login.tailscale.com/admin/settings/oauth
# 2. Create OAuth Client with scope: Devices (Core: Read & Write)
# 3. Create operator-oauth Secret in network namespace:
#    kubectl create secret generic operator-oauth -n network \
#      --from-literal=client_id="<YOUR_CLIENT_ID>" \
#      --from-literal=client_secret="<YOUR_CLIENT_SECRET>"
apiVersion: v1
kind: Secret
metadata:
  name: operator-oauth
  namespace: network
type: Opaque
stringData:
  client_id: "your-tailscale-oauth-client-id"
  client_secret: "your-tailscale-oauth-client-secret"
