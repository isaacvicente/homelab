# To create:
# 1. Update the admin_password with your desired Grafana admin password.
# 2. Encrypt using SOPS with age:
#    sops --encrypt grafana-admin-secret.sops.yaml.example > grafana-admin-secret.sops.yaml
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin-secret
  namespace: monitoring
type: Opaque
stringData:
  admin_password: "your-grafana-admin-password"
