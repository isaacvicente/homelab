config:
  core.https_address: '{{ incus_https_address }}'
networks:
- config:
    ipv4.address: {{ incus_network_ipv4_address }}
    ipv6.address: {{ incus_network_ipv6_address }}
  name: {{ incus_network_name }}
  type: ""
  project: default
storage_pools:
- config: {}
  name: {{ incus_storage_pool_name }}
  driver: {{ incus_storage_pool_driver }}
profiles:
- config: {}
  devices:
    eth0:
      name: eth0
      network: {{ incus_network_name }}
      type: nic
    root:
      path: /
      pool: {{ incus_storage_pool_name }}
      type: disk
  name: default
projects: []
cluster: null
