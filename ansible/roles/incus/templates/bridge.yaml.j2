# Managed by Ansible — do not edit manually.
# Creates a Linux bridge ({{ incus_bridge_name }}) over {{ incus_bridge_parent_interface }}.
# The bridge has a fixed IP ({{ incus_bridge_ip }}/{{ incus_bridge_prefix }}).
# VMs attached to the bridge get their IPs via the router's DHCP.
network:
  version: 2
  renderer: networkd
  ethernets:
    {{ incus_bridge_parent_interface }}:
      dhcp4: false
      dhcp6: false
  bridges:
    {{ incus_bridge_name }}:
      interfaces:
        - {{ incus_bridge_parent_interface }}
      dhcp4: false
      addresses:
        - {{ incus_bridge_ip }}/{{ incus_bridge_prefix }}
      routes:
        - to: default
          via: {{ incus_bridge_gateway }}
      nameservers:
        addresses: {{ incus_bridge_dns | to_json }}
      parameters:
        stp: false
        forward-delay: 0
